{
  "name": "greeting-ui-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for the Greetings UI application using Cypress and Cucumber",
  "main": "index.js",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^15.20.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "mocha-junit-reporter": "^2.2.1"
  },
  "cypress-cucumber-preprocessor": {
    "json": {
      "enabled": true
    },
    "e2e": {
      "stepDefinitions": [
        "cypress/e2e/step_definitions/[filepath].steps.ts",
        "cypress/e2e/step_definitions/common.steps.ts"
      ]
    }
  }
}
